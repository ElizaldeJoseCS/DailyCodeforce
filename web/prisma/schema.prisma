generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String?
  username        String         @unique
  cfHandle        String         @unique
  displayName     String?
  bio             String?        @default("")
  avatarUrl       String?
  bannerUrl       String?
  backgroundColor String?        @default("#030712")
  accentColor     String?        @default("#22d3ee")
  discordId       String?        @unique
  discordAvatar   String?
  role            String         @default("user")
  currentStreak   Int            @default(0)
  longestStreak   Int            @default(0)
  lastSolvedDate  DateTime?
  totalSolved     Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  progress        UserProgress[]
  sessions        Session[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("sessions")
}

model Problem {
  id            String         @id @default(cuid())
  cfContestId   Int
  cfIndex       String
  name          String
  rating        Int
  tags          String[]
  url           String
  createdAt     DateTime       @default(now())
  dailyProblems DailyProblem[]

  @@unique([cfContestId, cfIndex])
  @@map("problems")
}

model DailyProblem {
  id            String         @id @default(cuid())
  problemId     String
  problem       Problem        @relation(fields: [problemId], references: [id])
  tier          String
  date          DateTime
  editorialUrl  String?
  editorial     String?
  createdAt     DateTime       @default(now())
  progress      UserProgress[]

  @@unique([tier, date])
  @@index([tier, date])
  @@map("daily_problems")
}

model UserProgress {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  dailyProblemId String
  dailyProblem   DailyProblem @relation(fields: [dailyProblemId], references: [id])
  solvedAt       DateTime     @default(now())
  verified       Boolean      @default(false)

  @@unique([userId, dailyProblemId])
  @@map("user_progress")
}
