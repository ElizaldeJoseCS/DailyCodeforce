generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  emailVerified   Boolean        @default(false)
  verificationCode String?
  verificationCodeExpires DateTime?
  passwordHash    String?
  username        String         @unique
  cfHandle        String         @unique
  displayName     String?
  bio             String?        @default("")
  avatarUrl       String?
  bannerUrl       String?
  backgroundColor String?        @default("#030712")
  accentColor     String?        @default("#22d3ee")
  socialLinks     Json?
  profileLayout   Json?
  avatarFrame     String?        @default("none")
  titleBadge      String?
  discordId       String?        @unique
  discordAvatar   String?
  role            String         @default("user")
  currentStreak   Int            @default(0)
  longestStreak   Int            @default(0)
  lastSolvedDate  DateTime?
  totalSolved     Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  progress        UserProgress[]
  sessions        Session[]
  comments        Comment[]
  votes           CommentVote[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("sessions")
}

model Problem {
  id            String         @id @default(cuid())
  cfContestId   Int
  cfIndex       String
  name          String
  rating        Int
  tags          String[]
  url           String
  testCases     Json?
  statement     Json?
  createdAt     DateTime       @default(now())
  dailyProblems DailyProblem[]

  @@unique([cfContestId, cfIndex])
  @@map("problems")
}

model DailyProblem {
  id            String         @id @default(cuid())
  problemId     String
  problem       Problem        @relation(fields: [problemId], references: [id])
  tier          String
  date          DateTime
  editorialUrl  String?
  editorial     String?
  discordPostedAt DateTime?
  createdAt     DateTime       @default(now())
  progress      UserProgress[]
  reports       EditorialReport[]
  comments      Comment[]

  @@index([tier, date])
  @@map("daily_problems")
}

model UserProgress {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  dailyProblemId String
  dailyProblem   DailyProblem @relation(fields: [dailyProblemId], references: [id])
  solvedAt       DateTime     @default(now())
  verified       Boolean      @default(false)

  @@unique([userId, dailyProblemId])
  @@map("user_progress")
}

model EditorialReport {
  id             String        @id @default(cuid())
  dailyProblemId String?
  dailyProblem   DailyProblem? @relation(fields: [dailyProblemId], references: [id])
  userId         String?
  message        String?
  createdAt      DateTime      @default(now())

  @@map("editorial_reports")
}

model Comment {
  id             String       @id @default(cuid())
  dailyProblemId String
  dailyProblem   DailyProblem @relation(fields: [dailyProblemId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  parentId       String?
  parent         Comment?     @relation("CommentReplies", fields: [parentId], references: [id])
  replies        Comment[]    @relation("CommentReplies")
  content        String
  upvotes        Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  votes          CommentVote[]

  @@index([dailyProblemId, createdAt])
  @@map("comments")
}

model CommentVote {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("comment_votes")
}
